# Supabase Dashboard > Project Settings > Database > Connection string
# Vercel等では Transaction pooler の接続文字列を推奨。
# 絶対に NEXT_PUBLIC_ を付けないこと。
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres?sslmode=require

# GMOあおぞらネット銀行 API
# sunabar: https://api.sunabar.gmo-aozora.com/corporation/v1
# 本番移行時は本番用URL・トークンへ差し替える。
GMO_BANK_API_BASE_URL=https://api.sunabar.gmo-aozora.com/corporation/v1
GMO_BANK_API_ACCESS_TOKEN=YOUR_ACCESS_TOKEN
GMO_BANK_API_ACCOUNT_ID=YOUR_ACCOUNT_ID
GMO_BANK_API_SOURCE_SYSTEM=gmo_aozora_sunabar_api
ACCOUNTING_COMPANY_NAME=akmic合同会社
